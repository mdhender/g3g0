#!/usr/bin/env bash
# Copyright (c) 2026 Michael D Henderson.
# SPDX-License-Identifier: AGPL-3.0-or-later
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT}"
export PATH="${HOME}/.local/bin:${PATH}"

echo "[setup ${SECONDS}s] Checking system dependencies"
packages=()
for package in build-essential ninja-build git curl ca-certificates perl libdigest-sha-perl xxd python3 patch diffutils tar gzip; do
	if ! dpkg-query -W -f='${Status}' "${package}" 2>/dev/null | grep -qx 'install ok installed'; then
		packages+=("${package}")
	fi
done
if ((${#packages[@]})); then
	sudo apt-get update -qq
	sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${packages[@]}"
fi

echo "[setup ${SECONDS}s] Installing Go from go.mod"
GO_VERSION="$(awk '$1 == "go" { print $2; exit }' go.mod)"
GO_HOME="${HOME}/.local/share/g3g0/go${GO_VERSION}"
if [[ ! -x "${GO_HOME}/bin/go" ]]; then
	case "$(uname -m)" in
	x86_64) arch=amd64 ;;
	aarch64) arch=arm64 ;;
	*) echo "Unsupported Go architecture: $(uname -m)" >&2; exit 1 ;;
	esac
	download="$(mktemp -d)"
	trap 'rm -rf "${download}"' EXIT
	archive="go${GO_VERSION}.linux-${arch}.tar.gz"
	curl -fsSL --retry 3 "https://dl.google.com/go/${archive}" -o "${download}/${archive}"
	checksum="$(curl -fsSL --retry 3 "https://dl.google.com/go/${archive}.sha256")"
	printf '%s  %s\n' "${checksum}" "${download}/${archive}" | sha256sum -c -
	tar -xzf "${download}/${archive}" -C "${download}"
	mkdir -p "$(dirname "${GO_HOME}")"
	mv "${download}/go" "${GO_HOME}"
	rm -rf "${download}"
	trap - EXIT
fi
mkdir -p "${HOME}/.local/bin"
ln -sfn "${GO_HOME}/bin/go" "${HOME}/.local/bin/go"
ln -sfn "${GO_HOME}/bin/gofmt" "${HOME}/.local/bin/gofmt"

# Login shells used by Amp and supervised services must see the installed tools.
marker='# G3G0 orb tools'
if ! grep -Fqx "${marker}" "${HOME}/.bash_profile" 2>/dev/null; then
	cat >> "${HOME}/.bash_profile" <<'EOF'

# G3G0 orb tools
case ":${PATH}:" in
	*:"${HOME}/.local/bin":*) ;;
	*) export PATH="${HOME}/.local/bin:${PATH}" ;;
esac
EOF
fi
go version

# G3's CMakeLists.txt requires 4.1; Debian 12's CMake is too old.
echo "[setup ${SECONDS}s] Checking CMake"
if ! command -v cmake >/dev/null || ! cmake --version | head -1 | grep -q 'cmake version 4\.1\.3$'; then
	uv tool install --force 'cmake==4.1.3'
fi

echo "[setup ${SECONDS}s] Preparing the upstream reference checkout"
G3_REPO="${G3_REPO:-${HOME}/Software/playbymail/olympia-g3}"
if [[ ! -e "${G3_REPO}" ]]; then
	mkdir -p "$(dirname "${G3_REPO}")"
	if [[ -d "${ROOT}/../repos/olympia-g3/.git" ]]; then
		ln -s "${ROOT}/../repos/olympia-g3" "${G3_REPO}"
	else
		git clone https://github.com/playbymail/olympia-g3 "${G3_REPO}"
	fi
fi
# Amp's additional repositories may be shallow. All compat tools use historical pins.
if [[ "$(git -C "${G3_REPO}" rev-parse --is-shallow-repository)" == true ]]; then
	git -C "${G3_REPO}" fetch --quiet --unshallow origin
fi
while read -r revision; do
	if ! git -C "${G3_REPO}" cat-file -e "${revision}^{commit}" 2>/dev/null; then
		git -C "${G3_REPO}" fetch --quiet origin "${revision}"
	fi
done < <(sed -nE 's/.*(G3_REV|PINNED_REV)=.*([0-9a-f]{40}).*/\2/p' tools/*/run.sh | sort -u)

echo "[setup ${SECONDS}s] Downloading Go modules and warming compilation caches"
go mod download
go test -run '^$' ./...
echo "[setup ${SECONDS}s] Ready"
